{
  "name": "hyper-tech-production-portal",
  "version": "2.1.0",
  "type": "module",
  "description": "Hyper-Tech Production Portal — B2B order-to-production workflow system (Express + PostgreSQL + Drizzle ORM). PLACEHOLDER NAME pending a final product name/domain.",
  "main": "dist/index.mjs",
  "scripts": {
    "build": "node ./build.mjs && npm run build:web",
    "build:web": "tsx web/scripts/build-tokens.ts && tsx web/scripts/check-contrast.ts && tsx web/scripts/check-copy.ts && tsx web/scripts/lint-web.ts && vite build --config web/vite.config.ts && tsx web/scripts/check-budgets.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test:web": "vitest run --config web/vitest.config.ts",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "tokens": "tsx web/scripts/build-tokens.ts",
    "check:contrast": "tsx web/scripts/check-contrast.ts",
    "start": "node dist/index.mjs",
    "dev": "tsx watch src/main.ts",
    "db:push": "drizzle-kit push",
    "db:migrate": "npm run db:preflight && node scripts/run-migrations.mjs",
    "db:migrate:identity": "tsx scripts/migrate-portal-identity.ts",
    "db:preflight": "node scripts/migration-preflight.mjs",
    "db:migrate:drizzle-kit-unused": "drizzle-kit migrate",
    "db:migrate:foundation": "node manual-migrate-foundation.js",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check:roles": "node scripts/check-role-consistency.mjs",
    "audit:baseline": "node scripts/phase0-baseline-audit.mjs",
    "audit:phase1": "node scripts/phase1-data-audit.mjs",
    "audit:foundation": "node scripts/foundation-reconciliation-audit.mjs",
    "check:repository": "node scripts/repository-self-check.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "typescript": "^5.9.3",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@fontsource/tajawal": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "axe-core": "^4.14.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.25.8",
    "esbuild-plugin-pino": "^2.3.3",
    "jsdom": "^29.1.1",
    "lucide-preact": "^1.53.0",
    "pino-pretty": "^13.1.3",
    "preact": "^11.0.1",
    "qrcode-generator": "^2.0.4",
    "thread-stream": "3.1.0",
    "tsx": "^4.19.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
