{
  "name": "hyper-tech-production-portal",
  "version": "2.1.0",
  "type": "module",
  "description": "Hyper-Tech Production Portal — B2B order-to-production workflow system (Express + PostgreSQL + Drizzle ORM). PLACEHOLDER NAME pending a final product name/domain.",
  "main": "dist/index.mjs",
  "scripts": {
    "build": "node ./build.mjs",
    "start": "node dist/index.mjs",
    "dev": "tsx watch src/main.ts",
    "db:push": "drizzle-kit push",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:migrate:drizzle-kit-unused": "drizzle-kit migrate",
    "db:migrate:foundation": "node manual-migrate-foundation.js",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check:roles": "node scripts/check-role-consistency.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "typescript": "^5.9.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.25.8",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "^4.19.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
