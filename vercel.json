{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "installCommand": "npx --yes npm@11 ci --include=dev",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/v1/chat/cron/maintenance",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/v1/cron/daily-brief",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/v2/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
