# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Local:  postgresql://postgres:password@localhost:5432/hypertech_erp
# Vercel: set this to the pooled connection string from the NEW, independent
#         Neon Postgres project created for this repository (Phase 1). Do not
#         reuse the source ERP's Neon database — this is a separate project.
DATABASE_URL=postgresql://postgres:password@localhost:5432/hypertech_erp

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Auth (JWT) ──────────────────────────────────────────────────────────────
# مفتاح سري قوي — غيّره في الإنتاج
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ⚠️ إجبارية ومختلفة تمامًا عن JWT_SECRET — السيرفر يرفض يشتغل من غيرها.
# بتعزل توكن عملاء بوابة الجملة عن توكن موظفي الشركة الداخليين تمامًا.
# ولّد قيمة عشوائية قوية مثلاً بـ:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PORTAL_JWT_SECRET=your-different-super-secret-portal-jwt-key-change-this

# ─── Portal activation and messaging ─────────────────────────────────────────
# Public origin only (scheme + host, without /portal.html or any other path).
# It is used to build one-time activation links sent to customers.
# PLACEHOLDER — replace with this new Vercel project's actual assigned domain
# once it exists (Phase 1, task 6). Do not reuse the source ERP's domain.
PORTAL_PUBLIC_URL=https://REPLACE-WITH-NEW-VERCEL-DOMAIN.vercel.app
# Shown to customers in rejection and additional-information messages.
PORTAL_SUPPORT_PHONE=01151774776
# ── Optional paid delivery providers (everything works WITHOUT them) ─────────
# Activation links and password resets are delivered for free by staff: the admin
# screen shows a copy-able link + a WhatsApp (wa.me) button. Configure a provider
# below only if you also want automatic SMS / email. If a variable is missing the
# system says "not delivered" honestly and the staff member sends the link.
# Generic HTTPS provider: POST { channel, to, from, message, event } with
# "Authorization: Bearer <API_KEY>".
# SMS provider
PORTAL_SMS_PROVIDER_API_KEY=
PORTAL_SMS_PROVIDER_URL=
# Sender name/number. (PORTAL_SMS_FROM is still read as a legacy alias.)
PORTAL_SMS_PROVIDER_FROM=
# Email provider (same contract as SMS)
PORTAL_EMAIL_PROVIDER_API_KEY=
PORTAL_EMAIL_PROVIDER_URL=
PORTAL_EMAIL_PROVIDER_FROM=
# Max activation links one staff member can issue per hour.
PORTAL_ACTIVATION_LINK_RATE_MAX=10
# OTP policy; the application clamps these values to the documented safe range.
PORTAL_OTP_TTL_MINUTES=10
PORTAL_OTP_MAX_ATTEMPTS=5

# ─── CORS ────────────────────────────────────────────────────────────────────
# الـ domain بتاع الفرونت اند لو كان على سيرفر منفصل
# اتركها فاضية لو الفرونت والباك على نفس السيرفر
# PLACEHOLDER — same new Vercel domain as PORTAL_PUBLIC_URL above.
CORS_ORIGIN=https://REPLACE-WITH-NEW-VERCEL-DOMAIN.vercel.app

# ─── Seed (تهيئة أولية) ──────────────────────────────────────────────────────
# كلمة مرور أول حساب مدير كامل (admin) — تُستخدم مرة واحدة عند تشغيل npm run db:seed
# لازم تكون قوية: 8 أحرف على الأقل + حرف كبير + حرف صغير + رقم
SEED_ADMIN_PASSWORD=


# Vercel Cron secret (chat maintenance: purge expired images + escalation sweep)
CRON_SECRET=

# Web Push (free instant chat notifications). Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
